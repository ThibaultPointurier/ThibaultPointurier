# Copier ces clés dans Dokploy → Docker Compose → Environment (fichier .env généré).

# Obligatoire : mot de passe admin Grafana
GRAFANA_ADMIN_PASSWORD=changez-moi-en-production

# Optionnel
GRAFANA_ADMIN_USER=admin

# URL publique de Grafana (liens / cookies). À aligner sur le domaine ajouté dans Dokploy :
# GRAFANA_ROOT_URL=https://grafana.votredomaine.fr
